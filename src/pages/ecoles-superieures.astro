---
import { ecoles } from '../data/ecoles.js';
---

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <!-- نفس head كما في concours.astro -->
  <link rel="stylesheet" href="/style.css" />
  <style is:inline>
    /* نفس تنسيقات collapsible و hero السابقة */
    .school-cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; margin-top: 2rem; }
    .school-card { /* تنسيق البطاقة */ }
  </style>
</head>
<body>
  <header id="main-header">...</header>
  <div class="sidebar" id="sidebar">
    <!-- هنا أضف رابط المدارس العليا في القائمة -->
    ...
  </div>

  <main class="concours-page">
    <!-- المحتوى الثابت مع الطي -->
    <div class="collapsible-wrapper">
      <button class="collapsible-btn" id="toggle-static-intro">
        <span>📋 دليل المدارس العليا</span>
        <i class="fas fa-chevron-down" id="toggle-icon"></i>
      </button>
      <div class="collapsible-content" id="static-intro-content">
        <section class="static-intro">
          <h1>المدارس العليا في المغرب</h1>
          <p>...</p>
          <!-- كل المحتوى الغني الذي لديك بالفعل -->
        </section>
      </div>
    </div>

    <h1 class="page-title">المدارس العليا</h1>
    <p class="page-intro">اختر المدرسة لعرض التفاصيل الكاملة.</p>

    <!-- عرض بطاقات المدارس -->
    <div class="school-cards-grid">
      {ecoles.map(ecole => (
        <div class="school-card">
          <h3>{ecole.nom}</h3>
          <p>{ecole.description}</p>
          <a href={`/ecoles-superieures/${ecole.slug}`} class="btn btn-outline">تفاصيل <i class="fas fa-arrow-left"></i></a>
        </div>
      ))}
    </div>
  </main>

  <footer class="site-footer">...</footer>
  <!-- سكريبتات الطي والـ JS الأساسية -->
</body>
</html>
