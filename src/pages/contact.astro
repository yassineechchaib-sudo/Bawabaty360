  <main>
    <h1 class="page-title">اتصل بنا</h1>
    <div class="contact-container">
      <form class="contact-form" id="contact-form" action="https://formspree.io/f/mwvaqvpq" method="POST">
        <div class="form-group">
          <label for="name">الاسم الكامل</label>
          <input type="text" id="name" name="name" required />
        </div>
        <div class="form-group">
          <label for="email">البريد الإلكتروني</label>
          <input type="email" id="email" name="email" required />
        </div>
        <div class="form-group">
          <label for="subject">الموضوع</label>
          <input type="text" id="subject" name="subject" required />
        </div>
        <div class="form-group">
          <label for="message">الرسالة</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">إرسال</button>
      </form>
      <div class="contact-info">
        <h3>معلومات التواصل</h3>
        <div class="info-item">
          <div class="info-icon"><i class="fas fa-map-marker-alt"></i></div>
          <div class="info-text">
            <p>الرباط، المغرب</p>
            <span class="label">العنوان</span>
          </div>
        </div>
        <div class="info-item">
          <div class="info-icon"><i class="fas fa-envelope"></i></div>
          <div class="info-text">
            <p>contact@bawabaty360.com</p>
            <span class="label">البريد الإلكتروني</span>
          </div>
        </div>
        <div class="info-item">
          <div class="info-icon"><i class="fas fa-phone-alt"></i></div>
          <div class="info-text">
            <p>+212 717249886</p>
            <span class="label">الهاتف</span>
          </div>
        </div>
        <div class="social-links">
          <a href="https://www.facebook.com/share/19eRYsV9ui/" target="_blank" aria-label="فيسبوك"><i class="fab fa-facebook-f"></i></a>
          <a href="https://wa.me/212717249886" target="_blank" aria-label="واتساب"><i class="fab fa-whatsapp"></i></a>
        </div>
      </div>
    </div>
