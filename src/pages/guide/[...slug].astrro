---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('guides');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={post.data.description} />
    <meta property="og:image" content={post.data.image || "https://bawabaty360.com/og-image.jpg"} />
    <title>{post.data.title} | بوابتي 360</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="/style.css" />
    <style>
      /* تنسيق المحتوى القادم من Markdown */
      .content :is(h2) { font-size: 1.5rem; margin-top: 2rem; margin-bottom: 1rem; color: var(--primary-light); }
      .content :is(h3) { font-size: 1.25rem; margin-top: 1.5rem; margin-bottom: 0.75rem; }
      .content :is(p) { font-size: 1.05rem; line-height: 1.8; margin-bottom: 1rem; }
      .content :is(ul, ol) { padding-right: 20px; margin-bottom: 1rem; }
      .content :is(li) { margin-bottom: 0.5rem; }
      .content :is(table) {
        width: 100%; border-collapse: collapse; margin: 1.5rem 0;
        background: #fff; border-radius: 8px; overflow: hidden;
        border: 1px solid var(--border-light, #e5e7eb);
      }
      .content :is(th, td) {
        padding: 0.75rem 1rem; border-bottom: 1px solid var(--border-light, #e5e7eb);
        text-align: right;
      }
      .content :is(th) { background-color: var(--primary-light); color: white; }
      .content :is(tr:nth-child(even)) { background-color: #f9fafb; }
      .content :is(a) { color: var(--primary-light); text-decoration: underline; }
      .content :is(blockquote) {
        border-right: 4px solid var(--primary-light); margin: 1rem 0;
        padding: 1rem 1.5rem; background: #f0f7ff; border-radius: 4px;
      }
      .content :is(code) { background: #f1f5f9; padding: 0.2rem 0.4rem; border-radius: 4px; font-size: 0.9rem; }
      .content :is(img) { max-width: 100%; height: auto; border-radius: 8px; margin: 1rem 0; }
    </style>
  </head>
  <body>
    <header id="main-header">
      <div class="header-container">
        <button class="hamburger" id="hamburger-btn" aria-label="القائمة">
          <i class="fas fa-bars"></i>
        </button>
        <a href="/" class="logo">
          <span class="logo-main">بوابتي</span><span class="logo-360">360</span>
        </a>
        <button class="dark-toggle" id="dark-toggle" aria-label="الوضع الليلي/النهاري">
          <i class="fas fa-moon"></i>
        </button>
      </div>
    </header>

    <div class="sidebar" id="sidebar">
      <div class="sidebar-header">
        <span class="sidebar-title">القائمة</span>
        <button class="sidebar-close" id="sidebar-close"><i class="fas fa-times"></i></button>
      </div>
      <nav class="sidebar-nav">
        <div class="nav-section"><h3>الأقسام</h3>
          <ul>
            <li class="nav-group"><span class="nav-group-title"><i class="fas fa-landmark"></i> القطاع العام</span>
              <ul class="sub-nav">
                <li><a href="/concours"><i class="fas fa-file-alt"></i> مباريات</a></li>
                <li><a href="/salaires-2026"><i class="fas fa-money-bill-wave"></i> الأجور 2026</a></li>
              </ul>
            </li>
            <li><a href="/secteur-prive"><i class="fas fa-building"></i> القطاع الخاص</a></li>
          </ul>
        </div>
        <div class="nav-section"><h3>أدلة تعليمية</h3>
          <ul>
            <li><a href="/guide-concours"><i class="fas fa-book"></i> الدليل الشامل للمباريات</a></li>
            <li><a href="/guide-cv"><i class="fas fa-file-alt"></i> كتابة السيرة الذاتية</a></li>
            <li><a href="/guide-oral"><i class="fas fa-microphone-alt"></i> اجتياز الاختبارات الشفوية</a></li>
            <li><a href="/echelles-guide"><i class="fas fa-layer-group"></i> نظام السلاليم والترقيات</a></li>
            <li><a href="/public-vs-prive"><i class="fas fa-balance-scale"></i> القطاع العام مقابل الخاص</a></li>
            <li><a href="/specialites-2026"><i class="fas fa-chart-line"></i> أفضل التخصصات المطلوبة</a></li>
            <li><a href="/sans-bac"><i class="fas fa-tools"></i> وظائف بدون بكالوريا</a></li>
          </ul>
        </div>
        <div class="nav-section"><h3>معلومات</h3>
          <ul>
            <li><a href="/qui-sommes-nous"><i class="fas fa-users"></i> من نحن</a></li>
            <li><a href="/equipe"><i class="fas fa-user-circle"></i> فريق العمل</a></li>
            <li><a href="/contact"><i class="fas fa-envelope"></i> اتصل بنا</a></li>
            <li><a href="/faq"><i class="fas fa-question-circle"></i> الأسئلة الشائعة</a></li>
            <li><a href="/politique-confidentialite"><i class="fas fa-shield-alt"></i> سياسة الخصوصية</a></li>
          </ul>
        </div>
      </nav>
    </div>
    <div class="sidebar-overlay" id="sidebar-overlay"></div>

    <main class="article-detail-container" style="max-width: 800px; margin: 2rem auto; padding: 1rem;">
      <a href="/ecoles-superieures" class="back-to-list" style="display: inline-block; margin-bottom: 1.5rem; color: var(--primary);">
        <i class="fas fa-arrow-right"></i> العودة إلى المدارس العليا
      </a>
      
      <article>
        <header>
          <h1>{post.data.title}</h1>
          <div class="article-meta" style="margin: 1rem 0; font-size: 0.9rem; color: #64748b;">
            <span>✍️ {post.data.author}</span>
            <span style="margin-right: 1rem;">📅 {new Date(post.data.pubDate).toLocaleDateString('ar-MA')}</span>
          </div>
          {post.data.image && <img src={post.data.image} alt={post.data.title} style="width:100%; border-radius:8px; margin-bottom:1.5rem;" />}
        </header>
        
        <div class="content">
          <Content />
        </div>
        
        <div class="author-signature" style="margin-top: 2rem; padding: 1rem; border-top: 1px solid #eee; font-size: 0.9rem; color: #555;">
          <p>✍️ <strong>{post.data.author}</strong> — <a href="/equipe">ياسين الإدريسي</a> | نُشرت في {new Date(post.data.pubDate).toLocaleDateString('ar-MA')}</p>
        </div>
      </article>
    </main>

    <footer class="site-footer">
      <div class="footer-content">
        <div class="footer-logo">
          <span class="logo-main">بوابتي</span><span class="logo-360">360</span>
        </div>
        <div class="footer-links">
          <a href="/contact">اتصل بنا</a>
          <a href="/faq">الأسئلة الشائعة</a>
          <a href="/politique-confidentialite">الخصوصية</a>
          <a href="/terms">شروط الاستخدام</a>
          <a href="/sitemap.xml">خريطة الموقع</a>
        </div>
        <p class="copyright">© 2026 بوابتي 360 - جميع الحقوق محفوظة</p>
      </div>
    </footer>

    <button class="scroll-top" id="scroll-top" aria-label="العودة للأعلى"><i class="fas fa-arrow-up"></i></button>
    <script is:inline src="/data.js"></script>
    <script is:inline src="/script.js"></script>
  </body>
</html>
