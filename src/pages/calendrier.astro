  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      if (typeof initCalendrier === 'function') initCalendrier();
      
      // نظام الطي
      const btn = document.getElementById('toggle-static-intro');
      const content = document.getElementById('static-intro-content');
      if (btn && content) {
        content.style.display = 'none'; // مطوي افتراضيًا
        btn.classList.remove('active');
        btn.addEventListener('click', function() {
          if (content.style.display === 'none') {
            content.style.display = 'block';
            btn.classList.add('active');
          } else {
            content.style.display = 'none';
            btn.classList.remove('active');
          }
        });
      }
    });
