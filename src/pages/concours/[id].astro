---
// صفحة تفاصيل المباراة – HTML ثابت كامل
import fs from 'node:fs';
import path from 'node:path';
import vm from 'node:vm';

export async function getStaticPaths() {
  // قراءة data.js محلياً من القرص (بدون أي طلب شبكة)
  const filePath = path.join(process.cwd(), 'public', 'data.js');
  const code = fs.readFileSync(filePath, 'utf-8');

  // تنفيذ الملف داخل sandbox آمن لالتقاط القيم المسندة إلى window
  const sandbox = { window: {} };
  vm.createContext(sandbox);
  try {
    vm.runInContext(code, sandbox);
  } catch (e) {
    console.error('فشل تنفيذ data.js داخل getStaticPaths:', e);
    return [];
  }

  // محاولة التقاط البيانات تحت أكثر من اسم محتمل تحسباً
  const allJobs =
    sandbox.window.concoursData ||
    sandbox.concoursData ||
    sandbox.window.allJobs ||
    sandbox.allJobs ||
    [];

  if (!Array.isArray(allJobs) || allJobs.length === 0) {
    console.warn('لم يتم العثور على مصفوفة concoursData في data.js');
    return [];
  }

  return allJobs.map(job => ({
    params: { id: job.id.toString() },
    props: { job }
  }));
}

const { job } = Astro.props;
const pageTitle = `${job.title || 'تفاصيل المباراة'} | بوابتي 360`;
const pageDescription = (job.content || job.description || 'تفاصيل مباراة التوظيف').substring(0, 160);

// بناء JSON-LD بشكل صحيح كـ object حقيقي ثم تحويله إلى JSON صالح
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "JobPosting",
  title: job.title || 'مباراة توظيف',
  description: job.content || job.description || 'تفاصيل المباراة',
  datePosted: job.datePub || '2026-06-01',
  validThrough: job.dateLimite || '2026-12-31',
  jobLocation: {
    "@type": "Place",
    address: {
      "@type": "PostalAddress",
      addressCountry: "MA",
      addressLocality: job.region || 'المغرب'
    }
  },
  hiringOrganization: {
    "@type": "Organization",
    name: job.organisation || 'جهة حكومية'
  }
};
---

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={pageDescription} />
