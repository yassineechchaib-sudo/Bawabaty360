---
// صفحة تفاصيل المباراة – HTML ثابت كامل
import fs from 'node:fs';
import path from 'node:path';
import vm from 'node:vm';

export async function getStaticPaths() {
  const filePath = path.join(process.cwd(), 'public', 'data.js');
  const code = fs.readFileSync(filePath, 'utf-8');
  const sandbox = { window: {} };
  vm.createContext(sandbox);
  try {
    vm.runInContext(code, sandbox);
  } catch (e) {
    console.error('فشل تنفيذ data.js:', e);
    return [];
  }
  const allJobs = sandbox.window.concoursData || sandbox.concoursData || [];
  if (!Array.isArray(allJobs) || allJobs.length === 0) return [];
  return allJobs.map(job => ({
    params: { id: job.id.toString() },
    props: { job }
  }));
}

const { job } = Astro.props;
const pageTitle = `${job.fullTitle || job.title} | بوابتي 360`;
const pageDescription = (job.introText || job.description || 'تفاصيل المباراة').substring(0, 160);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "JobPosting",
  title: job.fullTitle || job.title,
  description: job.introText || job.description || '',
  datePosted: job.datePub || '',
  validThrough: job.inscriptionFin || '',
  jobLocation: { "@type": "Place", address: { "@type": "PostalAddress", addressCountry: "MA", addressLocality: job.region || 'المغرب' } },
  hiringOrganization: { "@type": "Organization", name: job.ministry || 'جهة حكومية' }
};
---
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={pageDescription} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:image" content="https://bawabaty360.com/og-image.jpg" />
  <title>{pageTitle}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
  <link rel="stylesheet" href="/style.css" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
</head>
<body>
  <header id="main-header">
    <div class="header-container">
      <button class="hamburger" id="hamburger-btn" aria-label="القائمة"><i class="fas fa-bars"></i></button>
      <a href="/" class="logo"><span class="logo-main">بوابتي</span><span class="logo-360">360</span></a>
      <button class="dark-toggle" id="dark-toggle" aria-label="الوضع الليلي/النهاري"><i class="fas fa-moon"></i></button>
    </div>
  </header>
  <!-- الشريط الجانبي كما هو بدون تغيير -->
  <div class="sidebar" id="sidebar">...</div>
  <div class="sidebar-overlay" id="sidebar-overlay"></div>

  <main style="max-width: 800px; margin: 2rem auto; padding: 1rem;">
    <a href="/concours" class="back-to-list"><i class="fas fa-arrow-right"></i> العودة إلى المباريات</a>

    <article class="article-detail">
      <div class="article-header">
        <h2>{job.fullTitle || job.title}</h2>
      </div>

      <!-- الصورة (موجودة في القديم) -->
      {job.images && job.images.length > 0 ? (
        <div class="article-gallery">
          {job.images.map(img => (
            <div class="gallery-item">
              <img src={img} alt={job.title} onerror="this.src='data:image/svg+xml,...'" />
            </div>
          ))}
        </div>
      ) : job.image ? (
        <div class="image-placeholder">
          <img src={job.image} alt="إعلان رسمي" />
        </div>
      ) : (
        <div class="image-placeholder">
          <img src="data:image/svg+xml,..." alt="إعلان رسمي" />
        </div>
      )}

      {job.introText ? <p class="intro-text">{job.introText}</p> : ''}

      <h3>شروط المشاركة</h3>
      <p>{job.conditionsIntro || 'يشترط في المترشحين توفر الشروط التالية:'}</p>
      <ul class="conditions-list">
        {(job.conditions || []).map(c => <li>{c}</li>)}
      </ul>

      <h3>ملف الترشيح</h3>
      <p>{job.piecesIntro || 'يتكون ملف الترشيح من الوثائق التالية:'}</p>
      <ol class="pieces-list">
        {(job.pieces || []).map(p => <li>{p}</li>)}
      </ol>

      <h3>آخر أجل للتقديم</h3>
      <p>{job.deadlineIntro || 'يجب إيداع الترشيحات إلكترونياً قبل:'} <strong>{job.inscriptionFin}</strong>.</p>
      {job.deadline ? <div class="deadline-countdown"><i class="fas fa-hourglass-half"></i> <span data-deadline={job.deadline}></span></div> : ''}

      <p style="margin-top:1.5rem">
        📝 للتسجيل المباشر في المباراة:
        <a href={job.lienInscriptionDirecte || '#'} target="_blank" rel="noopener noreferrer" class="text-link">رابط التسجيل المباشر</a>
        {job.lienInscriptionDirecte ? <br/><small style="color:#64748b">⚡ في حال تعطل الرابط المباشر، استعمل زر "رابط التسجيل لاجتياز المباراة" في الأسفل.</small> : ''}
      </p>

      <h3>ملاحظات هامة</h3>
      <ul>
        {(job.notesImportantes || []).map(n => <li>{n}</li>)}
      </ul>

      <h3>مركز المباراة</h3>
      <p>{job.centreMabara || job.lieu}</p>

      <h3>طبيعة الاختبارات</h3>
      <p>{job.epreuves || 'تجرى المباراة على مرحلتين: اختبار كتابي واختبار شفوي.'}</p>

      <h3>بعد الاختبار</h3>
      <p>{job.apresTest || 'سيتم الإعلان عن النتائج عبر الموقع الرسمي للوزارة ومنصة التشغيل العمومي.'}</p>

      {job.regions ? (
        <>
          <h3>التوزيع الجهوي للمناصب</h3>
          <table class="salary-table">
            <thead><tr><th>الجهة</th><th>عدد المناصب</th></tr></thead>
            <tbody>
              {Object.entries(job.regions).map(([r, nb]) => <tr><td>{r}</td><td>{nb}</td></tr>)}
            </tbody>
          </table>
        </>
      ) : ''}

      {job.lienInscription ? (
        <a href={job.lienInscription} class="btn btn-primary btn-large" target="_blank">
          <i class="fas fa-pen"></i> رابط التسجيل لاجتياز المباراة
        </a>
      ) : ''}

      <div class="share-actions">
        <span>شارك هذه المباراة:</span>
        <div class="share-buttons-bottom">
          <button class="share-btn facebook" id="share-facebook"><i class="fab fa-facebook-f"></i> فيسبوك</button>
          <button class="share-btn whatsapp" id="share-whatsapp"><i class="fab fa-whatsapp"></i> واتساب</button>
          <button class="share-btn copy" id="copy-link"><i class="fas fa-link"></i> نسخ الرابط</button>
        </div>
      </div>

      <section class="suggestions-section">
        <h3><i class="fas fa-lightbulb"></i> قد يهمك أيضاً</h3>
        <div class="suggestions-grid" id="suggestions-container"></div>
      </section>
    </article>

    <div class="author-signature" style="margin-top:2rem; padding:1rem; border-top:1px solid #eee; font-size:0.9rem; color:#555;">
      <p>✍️ <strong>بقلم: فريق بوابتي 360</strong> — <a href="/equipe">ياسين الإدريسي</a> | نُشرت في {job.datePub || '2026'}</p>
    </div>
  </main>

  <footer class="site-footer">...</footer>
  <button class="scroll-top" id="scroll-top"><i class="fas fa-arrow-up"></i></button>

  <script is:inline src="/data.js"></script>
  <script is:inline src="/script.js"></script>
  <script type="application/json" id="job-data" set:html={JSON.stringify(job)}></script>
  <script is:inline>
    // نفس كود الاقتراحات والمشاركة السابق
  </script>
</body>
</html>
