<script is:inline>
  // معالجة عرض تفاصيل المباراة عند وجود ?id= في الرابط
  (function() {
    const params = new URLSearchParams(window.location.search);
    const id = params.get('id');
    if (id && window.allJobs) {
      const job = window.allJobs.find(j => j.id == id);
      if (job) {
        // إخفاء جميع أقسام القوائم
        document.querySelectorAll('.concours-section, .page-title, .static-intro').forEach(el => el.style.display = 'none');
        // إظهار قسم التفاصيل
        const detailSection = document.getElementById('article-detail-section');
        if (detailSection) detailSection.style.display = 'block';
        const detailContent = document.getElementById('article-detail-content');
        if (detailContent) {
          // بناء HTML تفاصيل الوظيفة (مبسط)
          detailContent.innerHTML = `
            <div class="analyse-bawabaty"><strong>📊 تحليل بوابتي 360:</strong> ${job.analyse || "فرصة ممتازة لحاملي الشهادات المطلوبة. ننصح بالاطلاع على الشروط بدقة والتسجيل المبكر."}</div>
            <h1>${job.title}</h1>
            <p><strong>القطاع:</strong> ${job.secteur || 'غير محدد'}</p>
            <p><strong>الجهة:</strong> ${job.region || 'غير محددة'}</p>
            <p><strong>آخر أجل:</strong> ${job.dateLimite || 'غير محدد'}</p>
            <div>${job.content || job.description || ''}</div>
          `;
        }
      }
    }
  })();
</script>
<style is:inline>
  .collapsible-wrapper {
    margin-bottom: 2rem;
    border: 1px solid var(--border-light, #ddd);
    border-radius: 8px;
    overflow: hidden;
  }
  .collapsible-btn {
    width: 100%;
    padding: 0.75rem 1rem;
    background: var(--bg-secondary, #f9f9f9);
    border: none;
    text-align: right;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: inherit;
    color: inherit;
  }
  .collapsible-btn:hover {
    background: var(--bg-hover, #f0f0f0);
  }
  .collapsible-btn .fa-chevron-down {
    transition: transform 0.3s;
  }
  .collapsible-btn.active .fa-chevron-down {
    transform: rotate(180deg);
  }
  .collapsible-content {
    padding: 1rem;
    display: block;
  }
  .collapsible-content.hidden {
    display: none;
  }
</style>
<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    const btn = document.getElementById('toggle-static-intro');
    const content = document.getElementById('static-intro-content');
    const icon = document.getElementById('toggle-icon');
    if (btn && content) {
      // نبدأ مخفيين
      content.style.display = 'none';
      btn.classList.remove('active');
      
      btn.addEventListener('click', function() {
        if (content.style.display === 'none') {
          content.style.display = 'block';
          btn.classList.add('active');
        } else {
          content.style.display = 'none';
          btn.classList.remove('active');
        }
      });
    }
  });
</script>
